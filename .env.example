# Core application (server only)
ANTHROPIC_API_KEY=
PENDING_ACTION_SECRET=replace-with-a-long-random-string
DATA_ENCRYPTION_KEY=replace-with-a-32-byte-base64-key

# Start safely with mock data. Change only after channel adapters are implemented.
ADAPTER_MODE=mock

# Database and team authentication (Supabase)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Naver Search Ads manager/agency credentials
NAVER_SA_API_KEY=
NAVER_SA_SECRET_KEY=
NAVER_SA_MANAGER_CUSTOMER_ID=

# Naver GFA manager/agency credentials
NAVER_GFA_CLIENT_ID=
NAVER_GFA_CLIENT_SECRET=
NAVER_GFA_REFRESH_TOKEN=
NAVER_GFA_MANAGER_ACCOUNT_NO=
# optional fallback when the manager account listing fails (comma-separated)
NAVER_GFA_AD_ACCOUNT_NO=

# Google Ads MCC credentials
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=

# Meta Business Manager / System User credentials
META_APP_ID=
META_APP_SECRET=
META_SYSTEM_USER_ACCESS_TOKEN=
META_BUSINESS_ID=

# 무료 LLM (조회 전용 어시스턴트). 없으면 Claude만 사용.
# Gemini: https://aistudio.google.com/apikey  /  Groq: FREE_LLM_BASE_URL=https://api.groq.com/openai/v1, FREE_LLM_MODEL=llama-3.3-70b-versatile
FREE_LLM_API_KEY=
FREE_LLM_BASE_URL=
FREE_LLM_MODEL=
